{
    "flex-layout.col#sac": {
        "children": [
            "rich-text#sac-footer-title",
            "custom-div#sac",
            "custom-div#footer-redes-sociais"
        ],
        "props": {
            "blockClass": [
                "sac-footer-container"
            ]
        }
    },
    "custom-div#sac": {
        "props": {
            "flexDirection": "column",
            "gap": "6px"
        },
        "children": [
            "rich-text#sac-footer",
            "rich-text#sac-footer-whatsap"
        ]
    },
    "rich-text#sac-footer-title": {
        "props": {
            "blockClass": [
                "sac-footer",
                "sac-title"
            ],
            "text": "Contato"
        }
    },
    "rich-text#sac-footer": {
        "props": {
            "blockClass": [
                "sac-footer",
                "sac"
            ],
            "text": "SAC: 0800 275 5700"
        }
    },
    "rich-text#sac-footer-whatsap": {
        "props": {
            "blockClass": [
                "sac-footer",
                "sac"
            ],
            "text": "Fale pelo WhatsApp: (88) 9 8821-7000"
        }
    }
}