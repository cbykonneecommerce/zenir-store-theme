{
    "image#safe1": {
        "props": {
            "blockClass": [
                "image-seguranca"
            ],
            "src": "https://tfcvih.vteximg.com.br/arquivos/safe1png.png"
        }
    },
    "image#safe2": {
        "props": {
            "blockClass": [
                "image-seguranca"
            ],
            "height": "50px",
            "src": "https://tfcvih.vtexassets.com/assets/vtex.file-manager-graphql/images/17bae550-c2d6-4845-ab85-acd269989b9d___5be0282b9787225882c7d9cc82b206a6.png"
        }
    },
    "flex-layout.col#institucional-menu-footer-seguranca": {
        "props": {
            "preventVerticalStretch": true,
            "preventHorizontalStretch": true,
            "preserveLayoutOnMobile": false,
            "blockClass": [
                "menu-institucional--footer"
            ]
        },
        "children": [
            "rich-text#menu-footer-institucional-seguranca-title",
            "custom-div#seguranca-images",
            "custom-div#footer-pagamentos"
        ]
    },
    "custom-div#footer-pagamentos": {
        "props": {
            "flexDirection": "column",
            "blockClass": [
                "pagamentos"
            ]
        },
        "children": [
            "rich-text#formas-pagamentos",
            "image#pagamentos"
        ]
    },
    "rich-text#menu-footer-institucional-seguranca-title": {
        "props": {
            "blockClass": [
                "menu-institucional--footer"
            ],
            "text": "Segurança"
        }
    },
    "custom-div#seguranca-images": {
        "props": {
            "alignItems": "center",
            "justifyContent": "center",
            "flexDirectionMobile": "row",
            "gap": "12px",
            "blockClass": [
                "images-security"
            ]
        },
        "children": [
            "image#safe1",
            "image#safe2"
        ]
    }
}