    },
    "rich-text#institucional-trocas-content-2": {
        "props": {
            "text": "J. ALVES E OLIVEIRA LTDA- CNPJ- 41.426.966/0001-72 \n Av Santos Dumont, 2456, salas 1406 a 1410, Bairro Aldeota - CEP 60.150-161- Fortaleza –CE \n PABX (88)3510-1500- www.zenirmoveis.com.br \n",
            "blockClass": [
                "institucional-trocas-conteudo-2",
                "institucional-conteudo"
            ]
