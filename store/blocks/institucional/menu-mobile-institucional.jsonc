{
  "menu-item#institucional-menu-mobile": {
    "props": {
      "blockClass": ["menu-mobile-institucional"],
      "type": "custom",
      "iconId": null,
      "highlight": false,
      "itemProps": {
        "type": "internal",
        "href": "#",
        "noFollow": true,
        "tagTitle": "Institucionais",
