{
    "search-result-layout": {
        "blocks": [
            "search-result-layout.desktop",
            "search-result-layout.mobile",
            "search-not-found-layout"
        ]
    },
    "search-result-layout.desktop": {
        "children": [
            "flex-layout.row#resultpaginabusca"
        ],
        "props": {
            "pagination": "show-more",
            "preventRouteChange": false,
            "defaultGalleryLayout": "grid",
            "showFacetQuantity": true
        }
    },
    "flex-layout.row#resultpaginabusca": {
        "children": [
            "flex-layout.col#contentpaginabusca"
        ],
        "props": {
            "preventHorizontalStretch": true,
            "fullWidth": true
        }
    },
    "flex-layout.col#contentpaginabusca": {
        "children": [
            "flex-layout.row#searchinfopaginabusca",
            "flex-layout.row#searchinfopaginabusca2",
            "flex-layout.row#fetchprevious",
            "flex-layout.row#productspaginabusca",
            "flex-layout.row#fetchmore"
        ],
        "props": {
            // "width": "grow",
            "preventVerticalStretch": true
        }
    },
    "flex-layout.row#searchinfopaginabusca": {
        "children": [
            "flex-layout.row#searchtitlepaginabusca"
            // "flex-layout.col#productCount",
            // "flex-layout.row#orderByAndSwitcher"
        ]
    },
    "flex-layout.row#searchinfopaginabusca2": {
        "children": [
            "flex-layout.col#productCountPaginaBusca",
            "flex-layout.row#orderByAndSwitcher"
        ]
    },
    "flex-layout.col#productCountPaginaBusca": {
        "children": [
            "total-products.v2#paginaBusca"
        ],
        "props": {
            "blockClass": "productCountColPaginaBusca"
        }
    },
    "total-products.v2#paginaBusca": {
        "props": {
            "message": "Foram encontrados <span>{recordsFiltered}</span> resultados para sua busca"
        }
    },
    "flex-layout.row#searchtitlepaginabusca": {
        "children": [
            "rich-text#titlepaginabusca",
            "search-title.v2"
        ],
        "props": {
            "blockClass": "searchTitle",
            "preventHorizontalStretch": true,
            "fullWidth": true
        }
    },
    "rich-text#titlepaginabusca": {
        "props": {
            "textAlignment": "CENTER",
            "textPosition": "CENTER",
            "text": "RESULTADO DA BUSCA PARA: ",
            "font": "t-heading-1",
            "blockClass": "searchTitleMessage"
        }
    },
    "flex-layout.row#productspaginabusca": {
        "children": [
            "search-content#paginabusca"
        ]
    },
    "search-content#paginabusca": {
        "blocks": [
            "gallery#paginabusca",
            "not-found"
        ]
    },
    "gallery#paginabusca": {
        "props": {
            "layouts": [
                {
                    "name": "grid",
                    "component": "GridSummary",
                    "itemsPerRow": {
                        "desktop": 4,
                        "tablet": 3,
                        "phone": 2
                    }
                }
            ],
            "GridSummary": "product-summary.shelf"
        }
    }
}