{
	"vtex.menu@2.x:submenu#submenu-cama-mesa": {
		"props": {
			"blockClass": "submenu-header"
		},
		"children": [
			"flex-layout.row#submenu-cama-mesa"
		]
	},
	"flex-layout.row#submenu-cama-mesa": {
		"children": [
			"vtex.menu@2.x:menu#menu-cama-mesa"
		],
    "props": {
      "blockClass": "submenu-header"
    }
	},
	"vtex.menu@2.x:menu#menu-cama-mesa": {
		"props": {
			"orientation": "vertical",
      "blockClass": "menu-header"
		},
		"children": [
			"flex-layout.row#menu-cama-mesa"
		]
	},
	"flex-layout.row#menu-cama-mesa": {
    "children": [
      "flex-layout.col#menu-menu-imagem"
    ],
    "props": {
      "blockClass": ["menu-header", "imagem-menu"]
    }
  },
  "flex-layout.col#menu-menu-imagem": {
    "children": [
      "toggle-layout#imagem-do-menu"
    ],
    "props": {
      "blockClass": "menu-header-imagem"
    }
  },
  "toggle-layout#imagem-do-menu": {
    "title": "Imagem do menu cama-mesa",
    "children": [
      "image#menu-cama-mesa-imagem"
    ]
  },
  "image#menu-cama-mesa-imagem": {
		"props": {
			"src": "/arquivos/menu-iphone.png",
			"blockClass": "menu-imagem",
      "width": 300,
      "height": 376
		}
	}
}