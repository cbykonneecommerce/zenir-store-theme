{
	"vtex.menu@2.x:submenu#submenu-eletrodomesticos": {
		"props": {
			"blockClass": "submenu-header"
		},
		"children": [
			"flex-layout.row#submenu-eletrodomesticos"
		]
	},
	"flex-layout.row#submenu-eletrodomesticos": {
		"children": [
			"vtex.menu@2.x:menu#menu-eletrodomesticos"
		],
    "props": {
      "blockClass": "submenu-header"
    }
	},
	"vtex.menu@2.x:menu#menu-eletrodomesticos": {
		"props": {
			"orientation": "vertical",
      "blockClass": "menu-header"
		},
		"children": [
			"flex-layout.row#menu-eletrodomesticos"
		]
	},
	"flex-layout.row#menu-eletrodomesticos": {
    "children": [
      "flex-layout.col#menu-menu-imagem"
    ],
    "props": {
      "blockClass": ["menu-header", "imagem-menu"]
    }
  },
  "flex-layout.col#menu-menu-imagem": {
    "children": [
      "toggle-layout#imagem-do-menu"
    ],
    "props": {
      "blockClass": "menu-header-imagem"
    }
  },
  "toggle-layout#imagem-do-menu": {
    "title": "Imagem do menu eletrodomesticos",
    "children": [
      "image#menu-eletrodomesticos-imagem"
    ]
  },
  "image#menu-eletrodomesticos-imagem": {
		"props": {
			"src": "/arquivos/menu-iphone.png",
			"blockClass": "menu-imagem",
      "width": 300,
      "height": 376
		}
	}
}