{
  "search-result-layout.desktop": {
    "children": [
      "just-a-div#searchbanner",
      "flex-layout.row#result"
    ],
    "props": {
      "pagination": "show-more",
      "preventRouteChange": false,
      "defaultGalleryLayout": "grid",
      "showFacetQuantity": true
    }
  },
  "just-a-div#searchbanner": {
    "children": [
      "image#search"
      // "flex-layout.row#searchtitle"
    ],
    "props": {
      "blockClass": "category-banner"
    }
  },
  "image#search": {
    "props": {
      "src": "https://tfcvih.vtexassets.com/arquivos/banner-eletrodomesticos.jpg",
      "alt": "Banner categoria",
      "blockClass": "category-banner"
    }
  },
  "flex-layout.row#searchbread": {
    "children": [
      "breadcrumb.search"
    ],
    "props": {
      "preserveLayoutOnMobile": true,
      "fullWidth": true
    }
  },
  "flex-layout.row#searchtitle": {
    "children": [
      "experimental__visibility-layout#search-title"
    ],
    "props": {
      "blockClass": "category-banner-text"
    }
  },
  "experimental__visibility-layout#search-title": {
    "title": "Ocultar titulo de busca?",
    "children": [
      "search-title.v2"
    ],
    "props": {
      "visible": true
    }
  },
  "flex-layout.row#result": {
    "children": [
      "flex-layout.col#filter",
      "flex-layout.col#content"
    ],
    "props": {
      "blockClass": [
        "container",
        "main-desktop"
      ],
      "fullWidth": true,
      "preventHorizontalStretch": true
    }
  },
  "flex-layout.col#filter": {
    "children": [
      "filter-navigator.v3#desktop"
    ],
    "props": {
      "blockClass": "search-filter-navigator-col"
    }
  },
  "filter-navigator.v3#desktop": {
    "props": {
      "truncateFilters": false,
      "showClearByFilter": true,
      "navigationTypeOnMobile": "collapsible",
      "priceRangeLayout": "inputAndSlider",
      "initiallyCollapsed": false,
      "padding": 0
    },
    "blocks": [
      "sidebar-close-button"
    ]
  },
  "flex-layout.col#content": {
    "children": [
      "flex-layout.row#searchinfo",
      "custom-orderby-options",
      // "flex-layout.row#fetchprevious",
      "flex-layout.row#products",
      "flex-layout.row#fetchmore"
    ],
    "props": {
      "blockClass": "search-content",
      "preventVerticalStretch": true
    }
  },
  "flex-layout.row#searchinfo": {
    "props": {
      "blockClass": "search-info",
      "preventHorizontalStretch": true,
      "preventVerticalStretch": true
    },
    "children": [
      "search-title.v2",
      "total-products.v2"
    ]
  },
  "total-products.v2": {
    "props": {
      "blockClass": "category"
    }
  },
  "flex-layout.row#fetchprevious": {
    "props": {
      "marginBottom": 3
    },
    "children": [
      "search-fetch-previous"
    ]
  },
  "flex-layout.row#fetchmore": {
    "props": {
      "marginTop": 3
    },
    "children": [
      "search-fetch-more"
    ]
  },
  "search-fetch-previous": {
    "props": {
      "htmlElementForButton": "a"
    }
  },
  "search-fetch-more": {
    "props": {
      "htmlElementForButton": "a"
    }
  },
  "flex-layout.row#products": {
    "children": [
      "search-content"
    ]
  },
  "search-content": {
    "blocks": [
      "gallery",
      "not-found"
    ]
  }
}