{
    "custom-div#benefits-wrapper": {
        "title": "Faixa de benefícios",
        "props": {
            "justifyContent": "space-around",
            "flexDirectionMobile": "row",
            "blockClass": [
                "container",
                "beneficios-container"
            ]
        },
        "children": [
            "custom-div#benefit-free-shipping",
            "custom-div#benefit-free-assembly",
            "custom-div#benefit-installments-3x",
            "custom-div#benefit-installments-12x"
        ]
    },
    "custom-div#benefit-free-shipping": {
        "title": "Benefício - Frete Grátis",
        "props": {
            "flexDirection": "row",
            "alignItems": "center",
            "className": "beneficios-item"
        },
        "children": [
            "image#benefit-free-shipping-icon",
            "rich-text#benefit-free-shipping-text"
        ]
    },
    "image#benefit-free-shipping-icon": {
        "title": "Imagem - Frete Grátis",
        "props": {
            "src": "https://tfcvih.vtexassets.com/assets/vtex.file-manager-graphql/images/50a8b328-2930-4c47-80a3-f2508b2638e0___7903360519e118544b521bfba97f3c47.svg",
            "blockClass": [
                "beneficios-imagem"
            ]
        }
    },
    "rich-text#benefit-free-shipping-text": {
        "title": "Texto - Frete Grátis",
        "props": {
            "text": "Frete Grátis pra Você! <a href='/institucional/entrega-e-montagem' class='vtex-rich-text-0-x-paragraph--beneficios-sub'> Consulte o regulamento </a>",
            "blockClass": [
                "beneficios-text"
            ]
        }
    },
    "custom-div#benefit-free-assembly": {
        "title": "Benefício - Montagem Gratuita",
        "props": {
            "flexDirection": "row",
            "alignItems": "center",
            "className": "beneficios-item"
        },
        "children": [
            "image#benefit-free-assembly-icon",
            "rich-text#benefit-free-assembly-text"
        ]
    },
    "image#benefit-free-assembly-icon": {
        "title": "Imagem - Montagem Gratuita",
        "props": {
            "src": "https://tfcvih.vtexassets.com/assets/vtex.file-manager-graphql/images/66a0fb8e-d181-4e6a-b683-58d8d8c2df99___9deee055785abc18484d7c4416da6dfd.svg",
            "blockClass": [
                "beneficios-imagem"
            ]
        }
    },
    "rich-text#benefit-free-assembly-text": {
        "title": "Texto - Montagem Gratuita",
        "props": {
            "text": "Montagem Sem Custo! <a href='/institucional/entrega-e-montagem' class='vtex-rich-text-0-x-paragraph--beneficios-sub'>Verifique as condições.</a>",
            "blockClass": [
                "beneficios-text"
            ]
        }
    },
    "link#benefit-free-assembly-link": {
        "title": "Link - Montagem Gratuita",
        "props": {
            "label": "Consultar o regulamento",
            "blockClass": [
                "beneficios-link"
            ]
        }
    },
    "custom-div#benefit-installments-3x": {
        "title": "Benefício - 3x Sem Juros",
        "props": {
            "flexDirection": "row",
            "alignItems": "center",
            "className": "beneficios-item"
        },
        "children": [
            "image#benefit-installments-3x-icon",
            "rich-text#benefit-installments-3x-text"
        ]
    },
    "image#benefit-installments-3x-icon": {
        "title": "Imagem - 3x Sem Juros",
        "props": {
            "src": "https://tfcvih.vtexassets.com/assets/vtex.file-manager-graphql/images/1e4afa07-ffd0-4f6f-9a7f-68c1d62f9e1a___4fda56cb9e87d55b9cecaf9c456eef9c.svg",
            "blockClass": [
                "beneficios-imagem"
            ]
        }
    },
    "rich-text#benefit-installments-3x-text": {
        "title": "Texto - 3x Sem Juros",
        "props": {
            "text": "3x Sem Juros no Cartão! <a href='/institucional/entrega-e-montagem' class='vtex-rich-text-0-x-paragraph--beneficios-sub'>Consulte as regras.</a>",
            "blockClass": [
                "beneficios-text"
            ]
        }
    },
    "custom-div#benefit-installments-12x": {
        "title": "Benefício - 12x Parcelado",
        "props": {
            "flexDirection": "row",
            "alignItems": "center",
            "className": "beneficios-item"
        },
        "children": [
            "image#benefit-installments-12x-icon",
            "rich-text#benefit-installments-12x-text"
        ]
    },
    "image#benefit-installments-12x-icon": {
        "title": "Imagem - 12x Parcelado",
        "props": {
            "src": "https://tfcvih.vtexassets.com/assets/vtex.file-manager-graphql/images/ef54d4bc-2c49-4e95-be62-7983f695342a___de9f035ccece5f5f8e18a9889387e67c.svg",
            "blockClass": [
                "beneficios-imagem"
            ]
        }
    },
    "rich-text#benefit-installments-12x-text": {
        "title": "Texto - 12x Parcelado",
        "props": {
            "text": "Parcele em até 12x <a href='/institucional/entrega-e-montagem' class='vtex-rich-text-0-x-paragraph--beneficios-sub'>Sujeito a condições do cartão</a>",
            "blockClass": [
                "beneficios-text"
            ]
        }
    }
}