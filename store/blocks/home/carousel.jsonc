{
    "list-context.image-list#carousel": {
        "children": [
            "slider-layout#carousel-images"
        ],
        "props": {
            "autoplay": {
                "timeout": 3000,
                "stopOnHover": true
            },
            "preload": true,
            "images": [
                {
                    "image": "https://tfcvih.vteximg.com.br/arquivos/carousel.png",
                    "mobileImage": "https://tfcvih.vteximg.com.br/arquivos/mobile-carousel.png"
                },
                {
                    "image": "https://tfcvih.vteximg.com.br/arquivos/carousel.png",
                    "mobileImage": "https://tfcvih.vteximg.com.br/arquivos/mobile-carousel.png"
                }
            ]
        }
    },
    "slider-layout#carousel-images": {
        "props": {
            "autoplay": {
                "timeout": 3000,
                "stopOnHover": true
            },
            "itemsPerPage": {
                "desktop": 1,
                "tablet": 1,
                "phone": 1
            },
            "showPaginationDots": "always",
            "infinite": true,
            "showNavigationArrows": "never",
            "blockClass": ["carousel", "banner-dots"]
        }
    }
}