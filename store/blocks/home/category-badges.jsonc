{
    "flex-layout.row#category-badges": {
        "title":"Seção de Categorias",
        "props": {
            "blockClass": [
                "container",
                "categorie-badges",
                "section-home"
            ],
            "title": "box de categorias"
        },
        "children": [
            "flex-layout.col#category-badges"
        ]
    },
    "flex-layout.col#category-badges": {
        "props": {},
        "children": [
            "rich-text#category-badges-title",
            "flex-layout.row#categories"
        ]
    },
    "rich-text#category-badges-title": {
        "props": {
            "blockClass": [
                "shelf-title"
            ],
            "text": "Navegue por categorias"
        }
    },
    "flex-layout.row#categories": {
        "props": {
            "blockClass": [
                "categorie-badges-list"
            ]
        },
        "children": [
            "flex-layout.col#category-1",
            "flex-layout.col#category-2",
            "flex-layout.col#category-3",
            "flex-layout.col#category-4",
            "flex-layout.col#category-5",
            "flex-layout.col#category-6",
            "flex-layout.col#category-7",
            "flex-layout.col#category-8",
            "flex-layout.col#category-9"
        ]
    },
    "flex-layout.col#category-1": {
        "props": {
            "blockClass": [
                "categorie-badges-item",
                "categorie-badges-item-first"
            ]
        },
        "children": [
            "image#category-badge",
            "link#category-title"
        ]
    },
