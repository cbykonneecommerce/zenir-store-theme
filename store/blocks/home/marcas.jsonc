{
    "flex-layout.row#brands-badges": {
        "title": "Seção de marcas",
        "props": {
            "blockClass": [
                "container",
                "brand-badges",
                "section-home"
            ],
            "title": "box de marcas"
        },
        "children": [
            "flex-layout.col#brands-badges"
        ]
    },
    "flex-layout.col#brands-badges": {
        "props": {},
        "children": [
            "rich-text#brands-badges-title",
            "flex-layout.row#brands"
        ]
    },
    "rich-text#brands-badges-title": {
        "props": {
            "blockClass": [
                "shelf-title"
            ],
            "text": "Navegue por marcas"
        }
    },
    "flex-layout.row#brands": {
        "props": {
            "blockClass": [
                "categorie-badges-list"
            ]
        },
        "children": [
            "list-context.image-list#brand-images"
        ]
    },
    "list-context.image-list#brand-images": {
        "children": [
            "slider-layout#brands-images"
        ],
        "props": {
            "preload": true,
            "images": [
                {
                    "image": "https://tfcvih.vtexassets.com/assets/vtex.file-manager-graphql/images/567ed857-f6b0-4025-9bbb-324e1d0c337c___ecb567c6770494ce4006a33c581c8a72.png"
                },
                {
                    "image": "https://tfcvih.vtexassets.com/assets/vtex.file-manager-graphql/images/aae2fb71-5770-4599-bd5a-dca1316cb8f5___55e80ae0f071545c5b22749f08a60ab2.png"
                },
                {
                    "image": "https://tfcvih.vtexassets.com/assets/vtex.file-manager-graphql/images/64c3ab46-f38f-499b-bea4-994dd4359bd2___6329dc247bdc516927f39343e548a2cd.png"
                },
                {
                    "image": "https://tfcvih.vtexassets.com/assets/vtex.file-manager-graphql/images/ca45f5e4-27f4-4d69-b54c-3e3ad05a7dc8___ed83bf98ec635e5ebb944ed63cfa105f.png"
                },
                {
                    "image": "https://tfcvih.vtexassets.com/assets/vtex.file-manager-graphql/images/63ff7e51-c559-4999-aa8c-0818558353ae___12fd7a0aed042098053f964ecd679afd.png"
                },
                {
                    "image": "https://tfcvih.vtexassets.com/assets/vtex.file-manager-graphql/images/034077d6-1a61-455b-8f8d-3d11054ab9ba___2e86419bdc0451fd9d755d0ed2c3f441.png"
                }
            ]
        }
    },
    "slider-layout#brands-images": {
        "props": {
            "itemsPerPage": {
                "desktop": 6,
                "tablet": 4,
                "phone": 2
            },
            "infinite": false,
            "showNavigationArrows": "never",
            "showPaginationDots": "never",
            "blockClass": "carousel-brands-images"
        }
    }
}